{
  "name": "mudrix-desktop",
  "productName": "Mudrix",
  "version": "26.10.19",
  "private": true,
  "description": "Mudrix Desktop: the Mudrix web client in a Tauri shell",
  "homepage": "https://github.com/kapsikkum/mudrix-desktop",
  "author": "Arian Farahani, Jan Philipp Kleinschmidt (WizardChat Desktop); kapsikkum (Mudrix)",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kapsikkum/mudrix-desktop.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:web": "npm --prefix mudrix-web ci && npm --prefix mudrix-web run build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:dev:attach": "tauri dev --config src-tauri/tauri.attach.conf.json",
    "desktop:build": "tauri build",
    "version:check": "node scripts/check-version.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3"
  }
}
